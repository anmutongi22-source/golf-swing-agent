# Copy this file to .env and fill in your values. Never commit .env.

# Azure AI Foundry (matches the platform's .env.dev)
MODEL_PROVIDER=foundry
FOUNDRY_RESOURCE=aif-agentopsplat-dev
FOUNDRY_API_KEY=
MODEL_ID=claude-haiku-4-5
# Optional: set this if your Foundry endpoint URL is different
# FOUNDRY_ENDPOINT=https://aif-agentopsplat-dev.services.ai.azure.com/anthropic/v1/messages

# Or use the Anthropic API directly instead:
# MODEL_PROVIDER=anthropic
# ANTHROPIC_API_KEY=sk-ant-...
# MODEL_ID=claude-sonnet-4-5
